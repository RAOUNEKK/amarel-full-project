PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# set to true to only let admin users create/update/delete products
REQUIRE_ADMIN=true

# optional rate limits (requests per 15 minutes per IP)
# ORDER_RATE_LIMIT=10

# only needed for the seed script (creates one admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# optional, for Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
